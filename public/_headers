# Імена файлів тут містять хеш і міняються з кожною збіркою, тож можна вічно.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Фото своїх майстрів: імена стабільні, але фото замінне.
/img/barbers/*
  Cache-Control: public, max-age=3600, must-revalidate

# Запасна копія живого вмісту зі збірки. Її віддають лише доти, доки бот
# нічого не записав у KV, і кешувати її не можна з тієї самої причини.
/data/*
  Cache-Control: no-store

# Тестова адреса workers.dev не для пошуковиків: сайт живе на домені, а тут
# лише копія для перевірки, бот і відкат. Canonical і так веде на домен,
# noindex прибирає копію з видачі остаточно.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
